<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      The app targets televisions, so it must be installable where there is no touchscreen.
      `leanback` is declared but not required, so the same APK also installs on phones/tablets.
    -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.picture_in_picture"
        android:required="false" />

    <!--
      Needed to ask whether this device has a speech recognizer at all.

      Since API 30 an app cannot see handlers for an implicit intent unless it declares the ones it
      cares about, and without this `SpeechRecognizer.isRecognitionAvailable` returns false on every
      device - including ones that do have a working recognizer. The failure is silent and looks
      exactly like "this television has no microphone", which is the wrong conclusion to reach and the
      wrong reason to hide the voice button. The action is queried rather than the
      RECOGNIZE_SPEECH activity because `isRecognitionAvailable` asks about the service.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".FourJApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FourJ"
        android:usesCleartextTraffic="true"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.FourJ">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <!-- Phone/tablet launcher. -->
                <category android:name="android.intent.category.LAUNCHER" />

                <!--
                  Google TV and Android TV launchers only surface apps declaring
                  LEANBACK_LAUNCHER. Without this category the app is installed but invisible
                  on the television home screen, which is the single most common reason a
                  sideloaded TV app "doesn't show up".
                -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher background: a diagonal indigo-to-violet gradient.

    A flat colour was doing the job before, but an adaptive icon is shown against other icons on a
    home screen, and a solid dark square reads as a hole next to the colourful ones. The gradient
    gives it enough presence to hold its own while staying out of the way of the mark in front.

    Covers the full 108dp canvas rather than just the 72dp safe zone on purpose: the launcher crops
    this to whatever shape the device theme uses, and the corners have to belong to the icon too.

    The stops are duplicated in tools/make-icons.ps1, which paints the same gradient behind the
    legacy and banner bitmaps. Only this file is a vector; the other two are generated.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0.0" android:color="#FF4338CA" />
                <item android:offset="0.55" android:color="#FF6D28D9" />
                <item android:offset="1.0" android:color="#FF9333EA" />
            </gradient>
        </aapt:attr>
    </path>

    <!--
        A soft off-centre highlight, so the icon has some depth rather than reading as a printed
        sticker. Very low alpha on purpose: visible at arm's length, invisible as texture.
    -->
    <path android:pathData="M0,0 H108 V54 Q54,86 0,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="0"
                android:endY="64">
                <item android:offset="0.0" android:color="#33FFFFFF" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
